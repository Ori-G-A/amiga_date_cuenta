# Sin estas dos, storage.js usa localStorage (los datos no salen del navegador).
# La clave es la "publishable" del panel; VITE_SUPABASE_ANON_KEY sigue valiendo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Endpoint del becario: GET <url>?semana=YYYY-MM-DD → JSON.
# Sin esto, la vista semanal usa una serie simulada determinista.
VITE_BECARIO_URL=
